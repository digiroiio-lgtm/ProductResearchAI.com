# Canonical site origin (no trailing slash). Used for canonicals, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://productresearchai.com

# Optional. External page where buyers can view domain details or make an offer
# (for example a marketplace listing). When empty, the sale banner links to /domain.
NEXT_PUBLIC_DOMAIN_SALE_URL=

# Optional. Inquiry link for the "Make an Inquiry" button on /domain. Accepts https:// or mailto: URLs.
# Falls back to NEXT_PUBLIC_DOMAIN_SALE_URL when empty.
NEXT_PUBLIC_DOMAIN_CONTACT_URL=
